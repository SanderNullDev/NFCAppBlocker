<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug tag source. The DUMP permission limits senders to adb (shell) and the system. -->
        <receiver
            android:name=".debug.DebugTagReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="nl.nulldevelopment.nfcappblocker.debug.TAP_TAG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
