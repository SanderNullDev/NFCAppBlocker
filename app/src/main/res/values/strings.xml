    <string name="onboarding_notifications_on_title">Notifications are on</string>
    <string name="onboarding_notifications_body">While blocking is on, a quiet notification shows it, also outside the app.</string>
    <string name="onboarding_apps_title">Choose apps to block</string>
    <string name="onboarding_apps_body">Tapping \u201c%1$s\u201d blocks these apps, and tapping it again unblocks them.</string>
