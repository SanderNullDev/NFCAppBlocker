    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_welcome_title">Less time on your phone</string>
    <string name="onboarding_welcome_body">TikStop blocks the apps you choose. Tap an NFC tag to start blocking, and tap it again to stop.</string>
    <string name="onboarding_welcome_steps">Setting up takes a few minutes. You\'ll need your NFC tag.</string>
    <string name="onboarding_service_title">Switch on blocking</string>
    <string name="onboarding_service_body">To cover the apps you block, TikStop needs your permission in Android\'s Accessibility settings.</string>
    <string name="onboarding_service_how">In Settings, find TikStop (on Samsung phones under Installed apps), open it and switch it on. Then come back here.</string>
    <string name="onboarding_service_why">What does the app see?</string>
    <string name="onboarding_open_settings">Open settings</string>
    <string name="onboarding_service_on_title">Blocking is switched on</string>
    <string name="onboarding_service_on_body">TikStop can now cover the apps you block.</string>
    <string name="onboarding_restricted_title">Is the switch greyed out?</string>
    <string name="onboarding_restricted_step1">Open App info with the button below.</string>
    <string name="onboarding_restricted_step2">Tap the three dots at the top right.</string>
    <string name="onboarding_restricted_step3">Tap Allow restricted settings and confirm.</string>
    <string name="onboarding_restricted_step4">Come back here and tap Open settings again.</string>
    <string name="onboarding_open_app_info">Open App info</string>
    <string name="onboarding_skip">Skip for now</string>
    <string name="onboarding_finish">Finish</string>
    <string name="onboarding_tag_title">Add your tag</string>
    <string name="onboarding_tag_body">Hold the tag against the back of your phone, near the top, and keep it still for a moment.</string>
    <string name="onboarding_tag_waiting">Waiting for a tag…</string>
    <string name="onboarding_tag_added">Tag added</string>
    <string name="onboarding_tag_known">Tag recognised</string>
    <string name="onboarding_tag_name_hint">Give it a name if you like, for example where it is.</string>
